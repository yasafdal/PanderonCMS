@{
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panderon | Freshly Baked Cookies</title>
    <!-- Tailwind CSS for rapid styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Poppins', sans-serif;
        }
    </style>
</head>
<body class="bg-[#faf9f6] text-gray-800">

    <!-- Navigation -->
    <nav class="fixed w-full bg-white shadow-sm z-50 border-b border-gray-100">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <!-- Panderon Logo Style -->
            <a href="#" class="text-2xl font-bold text-[#5c3826] border-2 border-[#5c3826] rounded-full px-4 py-1 tracking-wide">
                panderon
            </a>
            <div class="hidden md:flex space-x-6">
                <a href="#about" class="hover:text-[#5c3826] font-medium transition">About</a>
                <a href="#cookies" class="hover:text-[#5c3826] font-medium transition">Our Cookies</a>
                <a href="#gallery" class="hover:text-[#5c3826] font-medium transition">Gallery</a>
                <a href="#faq" class="hover:text-[#5c3826] font-medium transition">FAQ</a>
                <a href="#contact" class="hover:text-[#5c3826] font-medium transition">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" class="pt-24 pb-12 md:pt-32 md:pb-24 px-4 max-w-6xl mx-auto flex flex-col-reverse md:flex-row items-center gap-8">
        <div class="md:w-1/2 text-center md:text-left">
            <h1 class="text-4xl md:text-6xl font-bold text-[#5c3826] leading-tight mb-4">
                One bite. You'll understand.
            </h1>
            <p class="text-lg text-gray-600 mb-8">
                Premium, handcrafted cookies baked fresh daily. Experience the rich flavors of our signature treats.
            </p>
            <a href="#contact" class="bg-[#5c3826] text-white px-8 py-3 rounded-full font-semibold hover:bg-[#45291c] transition shadow-lg">
                Send an Inquiry
            </a>
        </div>
        <div class="md:w-1/2">
            <!-- Pinalitan ko ang image ng banner para mas accurate sa brand nila -->
            <img src="Banner.jpg"
                 alt="Panderon Cookies Banner"
                 loading="lazy"
                 class="rounded-2xl shadow-md w-full object-cover">
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-16 bg-white px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-bold text-[#5c3826] mb-6">Our Story</h2>
            <p class="text-gray-600 leading-relaxed text-lg">
                Panderon started with a simple passion: to create the perfect cookie that brings a smile to everyone's face. We use only the finest ingredients, ensuring every bite is chewy, chunky, and absolutely unforgettable. Whether you need a sweet escape or a gift for a loved one, Panderon is here to deliver comfort in a box.
            </p>
        </div>
    </section>

    <!-- Cookies Section -->
    <section id="cookies" class="py-16 px-4 max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-[#5c3826] text-center mb-12">Signature Flavors</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Cookie 1 -->
            <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden group">
                <img src="https://images.unsplash.com/photo-1558961363-fa8fdf82db35?auto=format&fit=crop&w=500&q=80" alt="Chocolate Chip" loading="lazy" class="w-full h-56 object-cover group-hover:scale-105 transition duration-300">
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#5c3826] mb-2">Classic Choco Chip</h3>
                    <p class="text-gray-600 text-sm">Crispy edges, chewy centers, and loaded with premium chocolate chunks.</p>
                </div>
            </div>
            <!-- Cookie 2 -->
            <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden group">
                <div class="w-full h-56 bg-red-900 flex items-center justify-center">
                    <span class="text-white/50 font-semibold">[ Red Velvet Image Here ]</span>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#5c3826] mb-2">Red Velvet White Choco</h3>
                    <p class="text-gray-600 text-sm">Rich cocoa and vanilla dough mixed with sweet white chocolate chips.</p>
                </div>
            </div>
            <!-- Cookie 3 -->
            <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden group">
                <img src="https://images.unsplash.com/photo-1590080875515-8a3a8dc5735e?auto=format&fit=crop&w=500&q=80" alt="Matcha White" loading="lazy" class="w-full h-56 object-cover group-hover:scale-105 transition duration-300">
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#5c3826] mb-2">Matcha White</h3>
                    <p class="text-gray-600 text-sm">Earthy premium matcha flavor perfectly balanced with sweet white chocolate.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery & Feedbacks -->
    <section id="gallery" class="py-16 bg-[#f7f4ef] px-4">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold text-[#5c3826] text-center mb-12">Happy Cravings</h2>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
                <img src="https://images.unsplash.com/photo-1519869325930-281384150729?auto=format&fit=crop&w=300&q=80" alt="Gallery 1" loading="lazy" class="rounded-lg w-full h-40 object-cover shadow">
                <img src="https://images.unsplash.com/photo-1557089706-68d02dbda277?auto=format&fit=crop&w=300&q=80" alt="Gallery 2" loading="lazy" class="rounded-lg w-full h-40 object-cover shadow">
                <img src="https://images.unsplash.com/photo-1618923850106-9286eb330bc6?auto=format&fit=crop&w=300&q=80" alt="Gallery 3" loading="lazy" class="rounded-lg w-full h-40 object-cover shadow">
                <img src="https://images.unsplash.com/photo-1597733153203-a54d0fbc47de?auto=format&fit=crop&w=300&q=80" alt="Gallery 4" loading="lazy" class="rounded-lg w-full h-40 object-cover shadow">
            </div>

            <div class="bg-white p-8 rounded-xl shadow-md text-center max-w-3xl mx-auto italic border border-gray-100">
                "Honestly the best cookies I've had in the area! The packaging is beautiful, and the cookies are massive and gooey inside. Highly recommended!"
                <div class="mt-4 font-bold text-[#5c3826] not-italic">- Maria S. via Facebook</div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-16 px-4 max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-[#5c3826] text-center mb-8">Got Questions?</h2>
        <div class="space-y-4">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h3 class="font-bold text-[#5c3826] text-lg mb-2">How long do the cookies last?</h3>
                <p class="text-gray-600">Our cookies are best consumed within 3-4 days at room temperature. You can also refrigerate them for up to a week!</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
                <h3 class="font-bold text-[#5c3826] text-lg mb-2">Do you do bulk orders for events?</h3>
                <p class="text-gray-600">Yes! We accept bulk orders for birthdays, weddings, and corporate events. Please send us a message 1-2 weeks in advance.</p>
            </div>
        </div>
    </section>

    <!-- Contact & Maps Section -->
    <section id="contact" class="py-16 bg-white px-4 border-t border-gray-100">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row gap-12">
            <!-- Contact Form (Dummy) -->
            <div class="md:w-1/2">
                <h2 class="text-3xl font-bold text-[#5c3826] mb-6">Get in Touch</h2>
                <p class="text-gray-600 mb-6">Have a custom request or want to place an offline order? Drop us a line below or message us directly on our Facebook page.</p>
                <form class="space-y-4">
                    <input type="text" placeholder="Your Name" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#5c3826]">
                    <input type="email" placeholder="Your Email" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#5c3826]">
                    <textarea rows="4" placeholder="Your Message" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#5c3826]"></textarea>
                    <button type="button" class="bg-[#5c3826] text-white px-6 py-3 rounded-lg font-semibold hover:bg-[#45291c] transition w-full">Send Message</button>
                </form>
            </div>
            <!-- Dummy Map -->
            <div class="md:w-1/2">
                <h3 class="text-xl font-bold text-[#5c3826] mb-4">Our Location</h3>
                <div class="bg-gray-100 w-full h-64 md:h-80 rounded-xl flex items-center justify-center text-gray-500 mb-4 border border-gray-200">
                    <!-- Placeholder for actual Google Maps iframe -->
                    [ Google Maps iFrame will go here ]
                </div>
                <p class="text-gray-600"><strong class="text-[#5c3826]">Address:</strong> 123 Bakery Street, Sweet Town, PH</p>
                <p class="text-gray-600"><strong class="text-[#5c3826]">Hours:</strong> Monday - Saturday, 9:00 AM - 6:00 PM</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#5c3826] text-white py-6 text-center">
        <p>&copy; 2026 Panderon. All rights reserved.</p>
    </footer>

</body>
</html>